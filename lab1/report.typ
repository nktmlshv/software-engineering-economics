  (num: [E3], name: [Опыт работы с технологиями (Java, Spring Boot, React)], weight: 1, rating: 3),
  (num: [E4], name: [Способности аналитиков], weight: 0.5, rating: 3),
  (num: [E5], name: [Мотивация команды], weight: 1, rating: 4),
  (num: [E6], name: [Стабильность требований (требования зафиксированы в SRS)], weight: 2, rating: 3),
  (num: [E7], name: [Использование специалистов-контракторов (подрядчики не привлекались)], weight: -1, rating: 0),
  (num: [E8], name: [Сложность и распределённость команды], weight: -1, rating: 1),
)


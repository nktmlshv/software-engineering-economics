  let l = late.at(str(t.num))

  (
    num: t.num,
    name: t.name,
    preds: t.preds,
    duration: durations.find(
      d => d.num == t.num
    ).value,
    early_start: e.start,
    early_finish: e.finish,
    late_start: l.start,
    late_finish: l.finish,
    reserve: l.start - e.start,
  )
})

// Критический путь.
#let critical = schedule.filter(

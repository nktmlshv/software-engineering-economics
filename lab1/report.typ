#let ecf_show_2 = str(calc.round(ecf * 10000) / 10000)

ECF = 1.4 − 0.03 × EF = 1.4 − 0.03 × #ef = #ecf_show_2

=== Вычисление UCP

#let ucp = (uucw + uaw) * tcf * ecf
#let ucp_text = str(calc.round(ucp * 100) / 100)
#let pf = 640 / ucp
#let pf_text = str(calc.round(pf * 100) / 100)

UCP = (UUCW + UAW) × TCF × ecf_show_2

UCP = (#uucw + #uaw) × #tcf × #ecf_show_2 = #(uucw + uaw) × #tcf × #ecf_show_2 ≈ #ucp_text

Проект выполнялся двумя разработчиками около 16 недель при загрузке порядка 20 ч в неделю на человека; суммарные трудозатраты составили 640 чел.-ч. Это значение лежит внутри диапазона 468–936 чел.-ч, заложенного в SRS при планировании. Фактор продуктивности рассчитывается как отношение фактических трудозатрат к размеру проекта в UCP:

- UCP завершённого проекта = #ucp_text
- Затраченное время = 640 чел.-ч (два разработчика)
- PF = 640 / #ucp_text ≈ #pf_text чел.-ч на UCP

== Применение фактора продуктивности (PF)

#let infrastructure = 40
#let devops = 30
#let design = 60
#let testing = 50
#let project_management = 40

#let const_items = (
  (name: [Настройка инфраструктуры], hours: infrastructure),
  (name: [DevOps работы], hours: devops),
  (name: [Создание дизайна], hours: design),
  (name: [Тестирование], hours: testing),
  (name: [Управление проектом], hours: project_management),
)

#let const_total = const_items.map(item => item.hours).fold(0, (a, b) => a + b)

#let ucp_estimate = 183.4
#let pf_estimate = 5.48
#let development_effort = ucp_estimate * pf_estimate
#let total_effort = development_effort + const_total

#let development_effort_text = str(calc.round(development_effort * 10) / 10)
#let total_effort_text = str(calc.round(total_effort * 10) / 10)

Общее время разработки = UCP × PF + CONST

Где CONST включает:

#for item in const_items [
  - #item.name: #item.hours чч
]

- Итого CONST = #const_total чч

Общая оценка трудозатрат:

E = UCP × PF + CONST

E = #ucp_estimate × #pf_estimate + #const_total

E = #development_effort_text + #const_total = #total_effort_text ≈ #calc.round(total_effort) чч

= Вывод

#let ucp_effort = calc.round(total_effort)

#let estimation_results = (
  (method: [Наивный (без резерва; с резервом 20 % — 586)], effort: naive_effort),
  (method: [PERT], effort: pert_effort_1),
  (method: [UCP], effort: ucp_effort),
  (method: [МФТ + COCOMO II], effort: cocomo_effort),
)

#figure(
  table(
    columns: 3,
    align: left,
    table.header(
      [Метод оценки],

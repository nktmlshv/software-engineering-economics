// Преобразование числа в строку с двумя знаками после запятой.
#let fmt(value) = {
  let rounded = calc.round(value * 100)
  let whole = calc.floor(rounded / 100)
  let fractional = int(rounded - whole * 100)

  str(int(whole)) + "," + (
    if fractional < 10 {
      "0" + str(fractional)
    } else {
      str(fractional)
    }
  )
}

// Прямой проход: ранние сроки.
#let early = (:)

#for task in tasks {
  let start = if task.preds.len() == 0 {
    0
  } else {
    task.preds.map(
      p => early.at(str(p)).finish
    ).reduce(calc.max)
  }

  let duration = durations.find(
    d => d.num == task.num
  ).value

  early.insert(str(task.num), (
    start: start,
    finish: start + duration,
  ))
}

// Минимальная продолжительность проекта.
#let project_duration = tasks.map(
  t => early.at(str(t.num)).finish
).reduce(calc.max)

// Обратный проход: поздние сроки.
#let late = (:)

#for task in tasks.rev() {
  let successors = tasks.filter(
    t => t.preds.contains(task.num)
  )

  let finish = if successors.len() == 0 {
    project_duration
  } else {
    successors.map(
      t => late.at(str(t.num)).start
    ).reduce(calc.min)
  }

  let duration = durations.find(
    d => d.num == task.num
  ).value

  late.insert(str(task.num), (
    start: finish - duration,
    finish: finish,
  ))
}

